[Unit]
Description=PlantWise model and website on port 8175
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/src/github.com/bprashanth/plantwise/staging/serving
ExecStart=%h/src/github.com/bprashanth/plantwise/staging/.venv/bin/python -m uvicorn backend.app:create_app --factory --host 0.0.0.0 --port 8175 --workers 1 --limit-concurrency 16
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
Environment=GDAL_CACHEMAX=64

[Install]
WantedBy=default.target
