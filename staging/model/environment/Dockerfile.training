FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 JAVA_TOOL_OPTIONS=-Djava.awt.headless=true
RUN apt-get update && apt-get install -y --no-install-recommends r-base r-base-dev default-jdk build-essential gfortran libgdal-dev libgeos-dev libproj-dev libudunits2-dev libcurl4-openssl-dev libssl-dev libxml2-dev libfontconfig1-dev libfreetype6-dev libpng-dev libjpeg-dev libtiff-dev libharfbuzz-dev libfribidi-dev libglpk-dev cmake pkg-config ca-certificates curl r-cran-rjava r-cran-terra r-cran-raster r-cran-dplyr r-cran-remotes r-cran-jsonlite r-cran-digest
RUN R CMD javareconf
RUN Rscript -e 'remotes::install_version("ENMeval", version="2.0.5.2", repos="https://cloud.r-project.org", upgrade="never", Ncpus=2)'
RUN apt-get install -y --no-install-recommends libuv1-dev
RUN Rscript -e 'install.packages(c("Rcpp","dplyr"),repos="https://cloud.r-project.org",Ncpus=2); stopifnot(packageVersion("Rcpp") >= "1.1.0", packageVersion("dplyr") >= "1.2.0")' > /tmp/core-install.log 2>&1 || (tail -80 /tmp/core-install.log; exit 1)
RUN Rscript -e 'remotes::install_version("ENMeval", version="2.0.5.2", repos="https://cloud.r-project.org", upgrade="never", Ncpus=2); stopifnot(requireNamespace("ENMeval"))' > /tmp/enmeval-install.log 2>&1 || (tail -100 /tmp/enmeval-install.log; exit 1)
WORKDIR /work
RUN Rscript -e 'install.packages("dismo", repos="https://cloud.r-project.org", Ncpus=2); stopifnot(requireNamespace("dismo"), requireNamespace("ENMeval"))'
